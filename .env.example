# Скопируйте в .env и при необходимости поменяйте.
# docker compose читает .env автоматически; для локального запуска: set -a; . ./.env; set +a
PGHOST=localhost
PGPORT=5432
PGDATABASE=logs
PGUSER=logparser
PGPASSWORD=logparser
# часовой пояс для времени в логах без зоны (формат "Oct 10 12:34:56")
PGTZ=Asia/Novosibirsk
